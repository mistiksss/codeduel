# Скопируй в .env и подставь свои значения.
# Для локального запуска без Postgres можно не указывать DATABASE_URL —
# тогда будет SQLite-файл codeduel.db в корне проекта.

SECRET_KEY=сгенерируй-длинную-случайную-строку
PORT=5000

# Postgres (Render / Neon подставят DATABASE_URL сами)
# DATABASE_URL=postgresql://user:password@host:5432/codeduel
